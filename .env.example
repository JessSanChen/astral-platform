# Copy to .env.local for local development. Never commit a filled-in copy.
#
# For production, copy to .env.production.local instead and fill in the
# deployed values. The prod: npm scripts read that file and print which
# database they are about to touch. Both files are ignored by git.
# See docs/DEPLOY.md.

# Postgres connection string. On Neon, use the *pooled* one: the host has
# -pooler in it. db/index.ts sets prepare: false because it expects that.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Better Auth. Generate the secret with: openssl rand -base64 32
# BETTER_AUTH_URL is the address the app is served from, with no trailing
# slash. Sign-in checks the browser's origin against it, so in production it
# must be the deployed address. See docs/DEPLOY.md.
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-string
BETTER_AUTH_URL=http://localhost:3000

# OpenRouter. Server-side only; never exposed to the browser.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional, local testing only. Points the app at the mock provider in
# scripts/mock-openrouter.mjs so you can exercise chat without a key or spend.
# Leave this unset to talk to the real OpenRouter, and never set it in a
# deployment: it points at a server on your own machine, so every reply there
# would fail.
# OPENROUTER_BASE_URL=http://127.0.0.1:4010/api/v1

# Comma-separated addresses the seed script promotes to organizer, if an
# account with that address already exists. Read only by `npm run db:seed`
# and `npm run prod:seed`; signing up with one of these grants nothing.
# Addresses are not verified, so only list people who have already signed up.
ADMIN_EMAILS=you@example.com

# Shared code participants must enter to sign up. Can be changed later in the admin console.
EVENT_CODE=astral-boston
