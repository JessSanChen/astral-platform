# Copy to .env.local for local development. Never commit .env.local.

# Postgres connection string. On Neon use the *pooled* connection string.
DATABASE_URL=postgres://postgres@localhost:5433/astral?host=/tmp

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-string
BETTER_AUTH_URL=http://localhost:3000

# OpenRouter. Server-side only; never exposed to the browser.
OPENROUTER_API_KEY=sk-or-v1-...

# Comma-separated emails that get the admin role when they sign up.
ADMIN_EMAILS=you@example.com

# Shared code participants must enter to sign up. Can be changed later in the admin console.
EVENT_CODE=astral-boston
